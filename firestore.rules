rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isAuthenticated() {
      return request.auth != null;
    }

    // Roll/User ownership verification
    function isOwner(roll) {
      return isAuthenticated() && (
        request.auth.uid == roll ||
        (request.auth.token.keys().hasAll(['roll']) && request.auth.token.roll == roll) ||
        (request.auth.token.keys().hasAll(['email']) && resource != null && resource.data.email == request.auth.token.email)
      );
    }

    // Validate myth_users document payload
    function isValidUserPayload(data, roll) {
      return data.keys().hasAll(['name', 'roll', 'updatedAt'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 80
        && data.roll is string && data.roll == roll && data.roll.size() <= 40
        && (!data.keys().hasAll(['leetcode']) || (data.leetcode is string && data.leetcode.size() <= 60))
        && (!data.keys().hasAll(['theme']) || data.theme is string)
        && (!data.keys().hasAll(['lang']) || data.lang is string)
        && (!data.keys().hasAll(['codeMode']) || data.codeMode in ['cpp', 'java'])
        && (!data.keys().hasAll(['avatar']) || (data.avatar is string && data.avatar.size() <= 10));
    }

    // Validate myth_progress document payload
    function isValidProgressPayload(data) {
      return data.keys().hasAll(['updatedAt'])
        && (!data.keys().hasAll(['completedTopics']) || data.completedTopics is list)
        && (!data.keys().hasAll(['solvedProblems']) || data.solvedProblems is list)
        && (!data.keys().hasAll(['bookmarkedProblems']) || data.bookmarkedProblems is list);
    }

    // Validate myth_leaderboard document payload
    function isValidLeaderboardPayload(data, roll) {
      return data.keys().hasAll(['roll', 'name', 'lcSolved', 'platformSolved', 'compositePoints', 'updatedAt'])
        && data.roll is string && data.roll == roll
        && data.name is string && data.name.size() > 0 && data.name.size() <= 80
        && data.lcSolved is number && data.lcSolved >= 0 && data.lcSolved <= 5000
        && data.platformSolved is number && data.platformSolved >= 0 && data.platformSolved <= 500
        && data.compositePoints is number && data.compositePoints >= 0
        && (!data.keys().hasAll(['lcRanking']) || data.lcRanking is number);
    }

    // Validate docKey ownership for scratchpads & notes (format: {roll}_{probId}_{codeMode} or {roll}_{probId})
    function isDocKeyOwner(docKey) {
      return isAuthenticated() && (
        docKey.matches('^' + request.auth.uid + '_.*') ||
        (request.auth.token.keys().hasAll(['roll']) && docKey.matches('^' + request.auth.token.roll + '_.*'))
      );
    }

    // --- Collections ---

    // 1. User Profiles
    match /myth_users/{roll} {
      // Authenticated users can view student profiles
      allow read: if isAuthenticated();
      // Only the authenticated student can create or update their own profile with validated schema
      allow create: if isAuthenticated() && isValidUserPayload(request.resource.data, roll);
      allow update: if isAuthenticated() && isOwner(roll) && isValidUserPayload(request.resource.data, roll);
      allow delete: if false; // Deletions strictly prohibited from client
    }

    // 2. User Learning Progress
    match /myth_progress/{roll} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidProgressPayload(request.resource.data);
      allow update: if isAuthenticated() && isOwner(roll) && isValidProgressPayload(request.resource.data);
      allow delete: if false;
    }

    // 3. Global Leaderboard
    match /myth_leaderboard/{roll} {
      // Leaderboard is readable by all authenticated participants
      allow read: if true;
      // Per-user write validation ensuring no spoofed roll keys or illegal numerical bounds
      allow create, update: if isAuthenticated() && isOwner(roll) && isValidLeaderboardPayload(request.resource.data, roll);
      allow delete: if false;
    }

    // 4. Student Scratchpads (Code Editor) - Private to student
    match /myth_scratchpads/{docKey} {
      allow read: if isDocKeyOwner(docKey);
      allow create, update: if isDocKeyOwner(docKey)
        && request.resource.data.keys().hasAll(['code', 'updatedAt'])
        && request.resource.data.code is string
        && request.resource.data.code.size() <= 50000;
      allow delete: if isDocKeyOwner(docKey);
    }

    // 5. Student Problem Notes - Private to student
    match /myth_notes/{docKey} {
      allow read: if isDocKeyOwner(docKey);
      allow create, update: if isDocKeyOwner(docKey)
        && request.resource.data.keys().hasAll(['notes', 'updatedAt'])
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 20000;
      allow delete: if isDocKeyOwner(docKey);
    }

    // Default deny for all other unmatched collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
